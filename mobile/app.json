{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "owner": "mantech-bak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to capture your face for punch identification.",
        "NSLocationWhenInUseUsageDescription": "Location access is needed to record where you punched in/out."
      }
    },
    "android": {
      "package": "com.anonymous.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is needed to capture your face for punch identification."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location access is needed to record where you punched in/out."
        }
      ],
      "expo-font",
      "react-native-fast-tflite"
    ],
    "extra": {
      "eas": {
        "projectId": "71926401-a86e-4cbd-8ef4-b76a831ec106"
      }
    }
  }
}
